rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Change this to the Google email you use to open admin.html.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'aicareerlab124@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Each learner can read and write only their own progress. The admin can read everyone's.
    // Email sign-ups for new lessons: anyone can add their email once; only the admin can read the list.
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email is string && request.resource.data.email.size() < 200;
      allow read: if isAdmin();
    }
    // Feedback from the About page: anyone can send; only the admin can read.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['rating', 'text', 'name', 'canShow', 'uid', 'email', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5;
      allow read: if isAdmin();
    }
    // Certificates: anyone can look one up by its ID (the verify page). A signed-in learner can create
    // their own, once, only after their saved best exam score is 70% or more. Only the admin can list
    // all of them, cancel one (revoked) or delete one.
    match /certificates/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == id
        && request.resource.data.keys().hasOnly(['id', 'uid', 'name', 'course', 'courseName', 'testKey', 'score', 'issued'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && ((request.resource.data.course == 'intro' && request.resource.data.testKey == 'python')
          || (request.resource.data.course == 'data' && request.resource.data.testKey == 'pandas-ml'))
        && request.resource.data.score is int && request.resource.data.score >= 70 && request.resource.data.score <= 100
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.best[request.resource.data.testKey] >= 70;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']);
      allow delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
