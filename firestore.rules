rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Change this to the Google email you use to open admin.html.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kattasivateja35@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Each learner can read and write only their own progress. The admin can read everyone's.
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
